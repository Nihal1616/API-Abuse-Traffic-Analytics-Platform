{
  "openapi": "3.0.0",
  "info": {
    "title": "API Shield Security Dashboard API",
    "description": "API for security monitoring, threat detection, and anomaly analysis",
    "version": "1.0.0",
    "contact": {
      "name": "API Shield Team",
      "url": "https://api-shield.com",
      "email": "support@api-shield.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Development server"
    },
    {
      "url": "https://api.apishield.com/api",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Security",
      "description": "Security monitoring and threat detection endpoints"
    },
    {
      "name": "Metrics",
      "description": "Performance and security metrics endpoints"
    },
    {
      "name": "Admin",
      "description": "Administrative endpoints (requires authentication)"
    }
  ],
  "paths": {
    "/security/traffic": {
      "get": {
        "tags": ["Security"],
        "summary": "Get traffic data",
        "description": "Retrieve time-series traffic data for charts",
        "parameters": [
          {
            "name": "hours",
            "in": "query",
            "description": "Number of hours of data to retrieve",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 24,
              "minimum": 1,
              "maximum": 168
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Traffic data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrafficResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/security/anomalies": {
      "get": {
        "tags": ["Security"],
        "summary": "Get anomaly events",
        "description": "Retrieve anomaly events with optional filtering",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of anomalies to return",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 500
            }
          },
          {
            "name": "severity",
            "in": "query",
            "description": "Filter by severity level",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["low", "medium", "high", "critical"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Anomalies retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnomaliesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/security/threat-actors": {
      "get": {
        "tags": ["Security"],
        "summary": "Get threat actors",
        "description": "Retrieve threat actors with optional filtering",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of threat actors to return",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["active", "blocked", "monitoring"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Threat actors retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreatActorsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/security/actions/block": {
      "post": {
        "tags": ["Security"],
        "summary": "Block threat actor",
        "description": "Block a specific IP address",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ip": {
                    "type": "string",
                    "format": "ipv4",
                    "description": "IP address to block"
                  },
                  "reason": {
                    "type": "string",
                    "description": "Reason for blocking"
                  },
                  "duration": {
                    "type": "string",
                    "enum": ["1h", "6h", "24h", "7d", "permanent"],
                    "description": "Duration of the block"
                  }
                },
                "required": ["ip", "reason"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "IP blocked successfully"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/metrics/dashboard": {
      "get": {
        "tags": ["Metrics"],
        "summary": "Get dashboard metrics",
        "description": "Retrieve all metrics for the dashboard",
        "responses": {
          "200": {
            "description": "Dashboard metrics retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardMetrics"
                }
              }
            }
          }
        }
      }
    },
    "/admin/login": {
      "post": {
        "tags": ["Admin"],
        "summary": "Admin login",
        "description": "Authenticate admin user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/LoginResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "TimeSeriesData": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "requests": {
            "type": "integer"
          },
          "blocked": {
            "type": "integer"
          },
          "anomalies": {
            "type": "integer"
          },
          "responseTime": {
            "type": "number"
          }
        }
      },
      "TrafficResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeSeriesData"
            }
          }
        }
      },
      "AnomalyEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "rate_spike",
              "pattern_anomaly",
              "geo_anomaly",
              "credential_stuffing",
              "scraping",
              "ddos"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "description": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "endpoint": {
            "type": "string"
          },
          "sourceIp": {
            "type": "string",
            "format": "ipv4"
          },
          "recommendation": {
            "type": "string"
          }
        }
      },
      "AnomaliesResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnomalyEvent"
            }
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "ThreatActor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ip": {
            "type": "string",
            "format": "ipv4"
          },
          "country": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["active", "blocked", "monitoring"]
          },
          "threatScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "requestCount": {
            "type": "integer"
          },
          "blockedCount": {
            "type": "integer"
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time"
          },
          "attackTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ThreatActorsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThreatActor"
            }
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "DashboardMetrics": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "traffic": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TimeSeriesData"
                }
              },
              "anomalies": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AnomalyEvent"
                }
              },
              "threatActors": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ThreatActor"
                }
              },
              "summary": {
                "type": "object",
                "properties": {
                  "totalRequests": {
                    "type": "integer"
                  },
                  "blockedRequests": {
                    "type": "integer"
                  },
                  "anomalyCount": {
                    "type": "integer"
                  },
                  "threatActorsDetected": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
